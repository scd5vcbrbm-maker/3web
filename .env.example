# API Gateway Configuration
API_GATEWAY_PORT=3000
API_GATEWAY_HOST=0.0.0.0
NODE_ENV=production
NODE_WORKERS=4

# Master Key Configuration - KEEP SECURE!
MASTER_KEY_SECRET=your-master-key-secret-here-change-in-production-min-32-chars
MASTER_KEY_ALGORITHM=HS256
MASTER_PRIVATE_KEY=your-master-private-key-ecdsa-secp256k1
TOKEN_EXPIRY=24h

# Encryption Configuration
ENCRYPTION_ALGORITHM=aes-256-gcm
KEY_DERIVATION_FUNCTION=pbkdf2
KEY_DERIVATION_ITERATIONS=100000

# Database Configuration
DB_HOST=mongodb
DB_PORT=27017
DB_NAME=3web_saas
DB_USER=admin
DB_PASSWORD=your-secure-password-here
DATABASE_URL=mongodb://admin:password@mongodb:27017/3web_saas?authSource=admin

# Web3 Networks Configuration
WEB3_PROVIDER_URL=https://eth-mainnet.g.alchemy.com/v2/your-key
POLYGON_RPC_URL=https://polygon-rpc.com
ARBITRUM_RPC_URL=https://arb1.arbitrum.io/rpc
OPTIMISM_RPC_URL=https://mainnet.optimism.io

# TRON Configuration
TRON_MAINNET_RPC=https://api.tronstack.com
TRON_TESTNET_RPC=https://api.shasta.trongrid.io
TRON_PRIVATE_KEY=your-tron-private-key-here
TRON_DEFAULT_WALLET=TDLny8udzvBLDF5Ma743zxw22drta8WD9r
TRON_API_KEY=your-trongrid-api-key

# JWT Configuration
JWT_SECRET=your-jwt-secret-here-change-in-production-min-32-chars
JWT_EXPIRY=7d
JWT_REFRESH_EXPIRY=30d

# Security Configuration
SESSION_TIMEOUT=30
MAX_SESSIONS_PER_USER=5
MFA_ENABLED=true
MFA_METHOD=totp
REQUIRE_2FA_FOR_KEY_OPERATIONS=true
ALLOWED_IPS=
IP_WHITELIST_ENABLED=false

# Logging Configuration
LOG_LEVEL=info
LOG_FILE=logs/app.log
LOG_MAX_SIZE=10m
LOG_MAX_FILES=30
LOG_TO_DATABASE=true

# CORS Configuration
CORS_ORIGIN=*
CORS_CREDENTIALS=true
CORS_METHODS=GET,POST,PUT,DELETE,PATCH,OPTIONS

# Rate Limiting
RATE_LIMIT_WINDOW=15m
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_SKIP_SUCCESSFUL_REQUESTS=false

# API Keys for Third-party Services
INFURA_KEY=your-infura-key
ALCHEMY_KEY=your-alchemy-key
ETHERSCAN_API_KEY=your-etherscan-key
POLYGONSCAN_API_KEY=your-polygonscan-key
COINMARKETCAP_API_KEY=your-coinmarketcap-key
COINGECKO_API_KEY=your-coingecko-key

# Email Configuration (for notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=noreply@3web.io

# Redis Configuration (for caching & sessions)
REDIS_URL=redis://redis:6379
REDIS_PASSWORD=
REDIS_TTL=3600

# Webhook Configuration
WEBHOOK_TIMEOUT=30000
WEBHOOK_MAX_RETRIES=3
WEBHOOK_RETRY_DELAY=5000

# Monitoring & Analytics
SENTRY_DSN=
DATADOG_API_KEY=
DATADOG_APP_KEY=
ENABLE_PERFORMANCE_MONITORING=true
ENABLE_ERROR_TRACKING=true

# Backup & Recovery
BACKUP_ENABLED=true
BACKUP_INTERVAL=86400
BACKUP_LOCATION=/backups
BACKUP_RETENTION_DAYS=30

# Feature Flags
FEATURE_ADVANCED_TRADING=true
FEATURE_SMART_CONTRACTS=true
FEATURE_NFT_SUPPORT=true
FEATURE_STAKING=false
FEATURE_YIELD_FARMING=false

# Security Headers
STRICT_TRANSPORT_SECURITY=true
X_FRAME_OPTIONS=DENY
X_CONTENT_TYPE_OPTIONS=nosniff
X_XSS_PROTECTION=1; mode=block

# API Documentation
API_DOCS_ENABLED=true
API_DOCS_URL=/api-docs

# Debug Mode
DEBUG_MODE=false
DEBUG_LOG_REQUESTS=false
DEBUG_LOG_RESPONSES=false
